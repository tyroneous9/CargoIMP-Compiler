{
  "name": "ncaparser-server",
  "version": "1.0.0",
  "private": true,
  "description": "Express backend for NCAParser.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "db:migrate": "node scripts/migrate.js up",
    "db:migrate:down": "node scripts/migrate.js down 1",
    "db:migrate:baseline": "node scripts/migrate-baseline.js",
    "db:migrate:create": "node-pg-migrate create --migrations-dir migrations --migration-file-language js",
    "pipeline": "node scripts/run_pipeline.js",
    "pipeline:once": "node scripts/run_pipeline.js --once",
    "pipeline:force": "node scripts/run_pipeline.js --once --force"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "imapflow": "^1.1.0",
    "mailparser": "^3.7.5",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "node-pg-migrate": "^8.0.4"
  }
}
