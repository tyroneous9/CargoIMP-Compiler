# MVT (Movement / Manifest Status Message) grammar
#
# Induced from observed mailbox corpus (no official CIMP MVT specification exists).
# This grammar is intentionally permissive and structure-first, suitable for
# carrier status updates, cargo movement tracking, and operational notifications.
#
# Message structure:
# - Header (MVT)
# - Flight identification
# - Event status line (departure, arrival, or other operational event)
# - Optional supplemental lines (delays, PAX count, field status, etc.)
#
# IMPORTANT: Semantics below are provisional and inferred from observed messages
# plus operator guidance. No authoritative CIMP reference exists for MVT format.
# Timestamp encoding is inferred as DDHHMM (day-of-month + time in UTC when cross-
# referenced with business logic).

MVTMessage =
    MessageHeader EOL
    FlightIdentificationLine EOL
    EventLine
    *(EOL SupplementLine)
    [EOL];

MessageHeader = "MVT";

# ==================== FLIGHT IDENTIFICATION ====================
# First substantive line after header; identifies the flight and equipment.
# Format: carrier_flight/day.tail_registration.airport
# Examples:
# - KZ7132/15.N407KZ.ANC  => KZ flight 7132, day 15, aircraft registration N407KZ at ANC
# - KZ143/16.JA13KZ.NRT   => KZ flight 143, day 16, aircraft JA13KZ at NRT
# Useful fields:
# - CarrierFlightNumber: airline + numeric flight identifier
# - Day: operational day number carried on the flight identification line
# - AircraftRegistration: aircraft tail / registration number
# - AirportCode: three-letter airport code

FlightIdentificationLine =
    CarrierFlightNumber
    Slant
    Day
    Dot
    AircraftRegistration
    Dot
    AirportCode;

CarrierFlightNumber = 2Upper 3*4Digit;  # E.g., 'KZ7134'
Day = 2Digit;  # Day of month or operation
AircraftRegistration = 5*10AlphaNum;  # Tail number
AirportCode = 3Upper;  # IATA three-letter code

# ==================== EVENT LINE ====================
# Third line after header; the primary operational event or status update.
# Observed event families and formats:
# - AA142229          => Actual movement (departure only)
# - AA142229/142253   => Actual movement with arrival
# - AD151424 EA1954 ORD => Actual departure with estimated arrival time/airport
# - AD151424/151435 EA1955 ORD => Actual departure/arrival with estimated arrival
# - EA2220            => Estimated arrival only
# - ED150930          => Estimated departure
#
# Provisional semantics from operators:
# - AA lines: first DateTime6 = ActualDepartureDateTime, optional second = ActualArrivalDateTime
# - AD lines: similar to AA, but may include estimated arrival (EA) component
# - EA/ED: estimated arrival/departure (less common as primary event)

EventLine =
    ActualMovementLine
    / ActualDepartureEstimatedArrivalLine
    / EstimatedArrivalOnlyLine
    / EventDepartureLine;

# Format: AA {DDHHMM} [{/DDHHMM}]
# Provisional semantics from observed and operator-guided interpretation:
# - first DateTime6  = ActualDepartureDateTime
# - second DateTime6 = ActualArrivalDateTime (if present)
# Example: AA172109/172115 => departure day 17 21:09, arrival day 17 21:15
ActualMovementLine =
    "AA"
    ActualDepartureDateTime
    [Slant ActualArrivalDateTime];

# Format: AD {DDHHMM} [{/DDHHMM}] [{SP EA}time[ airport]]
# AD lines are less certain semantically than AA lines.
# Current provisional reading:
# - required DateTime6       = ActualDepartureDateTime
# - optional second DateTime6 = AdditionalActualDateTime (often arrival-related)
# - optional EA time/airport = EstimatedArrivalTime and optional EstimatedArrivalAirport
ActualDepartureEstimatedArrivalLine =
    "AD"
    ActualDepartureDateTime
    [Slant AdditionalActualDateTime]
    [SP "EA" EstimatedArrivalTime SP EstimatedArrivalAirport];

EstimatedArrivalOnlyLine = "EA" Time4;  # Estimated arrival time only
EventDepartureLine = "ED" DateTime6;  # Event departure (semantics less clear)

# ==================== SUPPLEMENTAL OPERATIONAL LINES ====================
# Optional operational/administrative updates that may follow the EventLine.
# Observed supplemental line types and formats:
# - DLRA/TD/2255/0200, DLWT/0130, DLFS/0025  => Delay lines (reason, times)
# - PX0, PX100                                => Passenger count
# - EB0415                                    => Event block code
# - FLD14                                     => Field state number
# - EDLAT/0005                                => Equipment/landing info
# - SI FMOC26-077 080 090 098 099 100         => Service item / remarks

SupplementLine =
    DelayLine
    / PaxLine
    / EventBlockLine
    / FieldStateLine
    / EdlatLine
    / SiLine;

# DL = Delay family (DLRA/DLWT/DLFS): delay code, reason, and optional time fields
DelayLine = DelayCode [Slant DelayReason] [Slant Time4] [Slant Time4];
DelayCode = "DLRA" / "DLWT" / "DLFS";  # Delay Reason/Weight/Fuel
DelayReason = 1*4Upper;  # Reason code

# PX = Passenger/Payload count
PaxLine = "PX" 1*3Digit;

# EB = Event Block status
EventBlockLine = "EB" Time4;

# FLD = Field status number
FieldStateLine = "FLD" 2Digit;

# EDLAT = Equipment data/landing info
EdlatLine = "EDLAT" Slant Time4;

# SI = Service Item / system instruction
SiLine = "SI" SP 1*LineChar;

# ==================== DATETIME & TIME ELEMENTS ====================
# All timestamps are provisional interpretations from observed data.
# Timestamp interpretation as UTC is inferred from operator mapping examples.

# DDHHMM: provisional interpretation as UTC-based when cross-referenced
# with business logic (e.g., "172115" maps to "April 17 16:15 CDT")
ActualDepartureDateTime = DateTime6;  # Actual departure date/time
ActualArrivalDateTime = DateTime6;    # Actual arrival date/time
AdditionalActualDateTime = DateTime6;  # Additional operational datetime
EstimatedArrivalTime = Time4;          # Estimated arrival time
EstimatedArrivalAirport = AirportCode;  # Estimated arrival destination

DateTime6 = 6Digit;  # DDHHMM format
Time4 = 4Digit;     # HHMM format

# ==================== CHARACTER SETS & PRIMITIVES ====================

LineChar = %x20-7E;  # Any printable ASCII character
SP = %x20;           # Space character (used in parsing)
EOL = [%x0D] %x0A;  # Optional CR + LF
Slant = "/";        # Forward slash delimiter
Dot = ".";          # Decimal point / field separator
Digit = %x30-39;    # '0' to '9'
Upper = %x41-5A;    # 'A' to 'Z'
AlphaNum = Upper / Digit;  # Uppercase letter or digit
