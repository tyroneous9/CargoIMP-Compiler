# FWB/17 CIMP 34th edition grammar (full message model)
# This grammar is intentionally structure-first: each line identifier
# explicitly maps to CIMP line tags (e.g., 'MWB' = Master Waybill Line).
#
# FWB (Freight Waybill) is the shipper's bill of lading; sent for consolidations,
# shipments, or forwarded house bills. The message carries one MASTER bill
# with one or more flight bookings, routing instructions, and party information.
#
# Per CIMP 34 Edition: FWB messages may be sent repeatedly as shipments evolve,
# and subsequent FWB messages (with same AWB number) supersede earlier ones.

FWB17 =
    MessageHeader EOL
    MasterAirwayBillLine EOL
    *FlightBookingsLine
    [RoutingLine]
    [ShipperBlock]
    [ConsigneeBlock]
    [AgentLine]
    *SsrLine
    [NotifyBlock]
    [AccountingLine]
    [CvdLine]
    [RatingLine]
    [OtherChargesLine]
    [PrepaidLine]
    [CertificationLine]
    [IssuanceLine]
    *SupplementalLine;

MessageHeader = "FWB/17";

# ==================== MASTER AIRWAYBILL (MWB) ====================
# Parsed from input line starting with airline-code + dash + serial (e.g., '933-12345678').
# Contains total counts and weight for the entire consolidated shipment.

MasterAirwayBillLine =
    MasterAirwayBillNumber
    OriginAndDestination
    TotalConsignmentSummary
    [Slant *LineChar];

MasterAirwayBillNumber = AirlinePrefix Hyphen AWBSerialNumber;
AirlinePrefix = 3Digit;
AWBSerialNumber = 8Digit;

OriginAndDestination = AirportCode AirportCode;
AirportCode = 3Upper;

TotalConsignmentSummary =
    Slant
    "T"
    TotalPieceCount
    WeightUnit
    TotalWeight
    [VolumeUnit VolumeAmount];

TotalPieceCount = 1*4Digit;
WeightUnit = "K" / "L";
TotalWeight = 1*10Digit ["." 1*3Digit];
VolumeUnit = "MC" / "CF" / 2Upper;
VolumeAmount = 1*10Digit ["." 1*3Digit];

# ==================== FLIGHT BOOKINGS (FLT) ====================
# One or more flight bookings for this consolidated shipment.
# Each booking specifies airline code, flight number, and priority (days integer).
# Example: FLT/KZ0143/01/KZ0142/02  => two flights booked, first by day 1, second by day 2.
# Per CIMP 34: FLT can repeat; continuation lines extend with additional flights.

FlightBookingsLine =
    "FLT"
    Slant
    2Upper 1*4Digit [Upper] Slant 2Digit
    *(Slant 2Upper 1*4Digit [Upper] Slant 2Digit)
    EOL
    *ContinuationLine;

# ==================== ROUTING (RTG) ====================
# Optional. Specifies intermediate/transfer airports for the shipment.
# Format: three-letter airport code, optionally followed by country/region code.
# Example: RTG/ORD/ANC/NRT  => route through Chicago, Anchorage, Narita.

RoutingLine =
    "RTG"
    Slant
    AirportCode [2Upper]
    *(Slant AirportCode [2Upper])
    EOL;

# ==================== SHIPPER PARTY BLOCK (SHP) ====================
# Shipper name, address, and location details.
# Structure: SHP [optional info] EOL followed by NAM, ADR, LOC sub-lines.
# Continuation lines (starting with Slant only) extend address/location text.

ShipperBlock = "SHP" [Slant *LineChar] EOL *ShipperSubLine;
ShipperSubLine = ShipperNameLine / ShipperAddressLine / ShipperLocationLine / ShipperContLine;
ShipperNameLine = "NAM" Slant *LineChar EOL;
ShipperAddressLine = "ADR" Slant *LineChar EOL;
ShipperLocationLine = "LOC" Slant *LineChar EOL;  # Location code or airport
ShipperContLine = Slant *LineChar EOL;

# ==================== CONSIGNEE PARTY BLOCK (CNE) ====================
# Consignee/receiver name, address, and location details.
# Structure: CNE [optional info] EOL followed by NAM, ADR, LOC sub-lines.
# Continuation lines extend address/location text.

ConsigneeBlock = "CNE" [Slant *LineChar] EOL *ConsigneeSubLine;
ConsigneeSubLine = ConsigneeNameLine / ConsigneeAddressLine / ConsigneeLocationLine / ConsigneeContLine;
ConsigneeNameLine = "NAM" Slant *LineChar EOL;
ConsigneeAddressLine = "ADR" Slant *LineChar EOL;
ConsigneeLocationLine = "LOC" Slant *LineChar EOL;
ConsigneeContLine = Slant *LineChar EOL;

# ==================== AGENT (AGT) ====================
# Freight forwarder or handling agent information.

AgentLine = AgentTagLine *AgentContLine;
AgentTagLine =
    "AGT"
    Slant
    *(%x20-2E / %x30-7E)
    Slant
    *(%x20-2E / %x30-7E)
    [Slant *(%x20-2E / %x30-7E)]
    [Slant *(%x20-2E / %x30-7E)]
    EOL;
AgentContLine = Slant *LineChar EOL;

# ==================== ACCOUNTING INFORMATION (ACC) ====================
# Carrier or shipper accounting details.

AccountingLine = AccountingTagLine *AccountingContLine;
AccountingTagLine = "ACC" Slant *LineChar EOL;
AccountingContLine = Slant *LineChar EOL;

# ==================== CHARGES VALUE DECLARATION (CVD) ====================
# Currency, charges, and insurance/value information.
# Format: CVD/currency/charge-code/insurance-code/charges/value/insurance-markup

CvdLine =
    "CVD"
    Slant
    3Upper
    Slant
    2Upper
    Slant
    2Upper
    Slant
    ("NVD" / 1*10Digit ["." 1*3Digit])
    Slant
    ("NCV" / "NVD" / 1*10Digit ["." 1*3Digit])
    Slant
    ("XXX" / 1*10Digit ["." 1*3Digit])
    EOL;

# ==================== RATING DESCRIPTION (RTD) ====================
# Rating and freight rate details.

RatingLine = RatingTagLine *RatingContLine;
RatingTagLine = "RTD" Slant *LineChar EOL;
RatingContLine = Slant *LineChar EOL;

# ==================== OTHER CHARGES (OTH) ====================
# Freight, handling, or additional charges (prefix 'P' = prepaid, 'C' = collect).

OtherChargesLine = OtherChargesTagLine *OtherChargesContLine;
OtherChargesTagLine = "OTH" Slant ("P" / "C") Slant *LineChar EOL;
OtherChargesContLine = Slant *LineChar EOL;

# ==================== PREPAID/COLLECT CHARGES SUMMARY (PPD) ====================
# Summary of weight charges (WT), valuation charges (VC), and taxes (TX).

PrepaidLine = PrepaidTagLine *PrepaidContLine;
PrepaidTagLine =
    "PPD"
    Slant
    "WT"
    1*10Digit ["." 1*3Digit]
    Slant
    "VC"
    1*10Digit ["." 1*3Digit]
    Slant
    "TX"
    1*10Digit ["." 1*3Digit]
    *(Slant *LineChar)
    EOL;
PrepaidContLine = Slant *LineChar EOL;

# ==================== CERTIFICATION & ISSUANCE ====================
# Certification (CER) and issuance date/agent information (ISU).

CertificationLine = "CER" Slant *LineChar EOL;
IssuanceLine =
    "ISU"
    Slant
    2Digit
    ("JAN" / "FEB" / "MAR" / "APR" / "MAY" / "JUN" /
     "JUL" / "AUG" / "SEP" / "OCT" / "NOV" / "DEC")
    2Digit
    Slant
    1*(%x20-2E / %x30-7E)
    Slant
    1*(%x20-2E / %x30-7E)
    *(Slant 1*(%x20-2E / %x30-7E))
    [EOL];

# ==================== SUPPLEMENTAL LINES ====================
# Optional operational/administrative notes and requests.

SupplementalLine = OsiBlock / OciBlock / RefLine / SphLine / ArdLine / SriLine;

# OSI = Operational Service Information (airline remarks)
OsiBlock = OsiLine *ContinuationLine;
OsiLine = "OSI" Slant *LineChar EOL;

# OCI = Other Charges Information
OciBlock = OciLine *ContinuationLine;
OciLine = "OCI" Slant *LineChar [EOL];

# FWB continuation lines may appear with 1 to 3 leading slashes (for alignment/embedding).
ContinuationLine = Slant [Slant [Slant]] *LineChar [EOL];

# REF = Reference number or identifier  
RefLine = "REF" Slant *LineChar [EOL];

# SPH = Special Handling / COR = Correction indicator
SphLine = ("SPH" / "COR") Slant *LineChar [EOL];

# ==================== SPECIAL SERVICE REQUEST (SSR) ====================
# Special handling requirements, insurance requests, or service instructions.

SsrLine = SsrTagLine *SsrContLine;
SsrTagLine = "SSR" Slant *LineChar EOL;
SsrContLine = Slant *LineChar EOL;

# ==================== NOTIFY PARTY BLOCK (NFY) ====================
# Delivery notification recipient details.

NotifyBlock = "NFY" [Slant *LineChar] EOL *NotifySubLine;
NotifySubLine = NotifyNameLine / NotifyAddressLine / NotifyLocationLine / NotifyContLine;
NotifyNameLine = "NAM" Slant *LineChar [EOL];
NotifyAddressLine = "ADR" Slant *LineChar [EOL];
NotifyLocationLine = "LOC" Slant *LineChar [EOL];
NotifyContLine = Slant *LineChar [EOL];

# ==================== REFERENCE IDENTIFIERS ====================
# ARD = Account reference / document ID; SRI = Shipment reference ID

ArdLine = "ARD" Slant *LineChar [EOL];
SriLine = "SRI" Slant *LineChar [EOL];

# ==================== AUXILIARY ELEMENTS ====================

LineChar = %x20-7E;  # Any visible ASCII character

EOL = [%x0D] %x0A;
Slant = "/";
Hyphen = "-";
Digit = %x30-39;
Upper = %x41-5A;
