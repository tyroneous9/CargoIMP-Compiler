# FWB/17 CIMP 34th edition grammar (full message model)
# This grammar is intentionally structure-first: each line identifier has
# a dedicated production with typed data elements and controlled continuations.

FWB17 =
    MessageHeader EOL
    AirWaybillLine EOL
    *FlightBookingsLine
    [RoutingLine]
    [ShipperBlock]
    [ConsigneeBlock]
    [AgentLine]
    *SsrLine
    [NotifyBlock]
    [AccountingLine]
    [CvdLine]
    [RatingLine]
    [OtherChargesLine]
    [PrepaidLine]
    [CertificationLine]
    [IssuanceLine]
    *SupplementalLine;

MessageHeader = "FWB/17";

# --- Core AWB line ---
AirWaybillLine =
    MasterAirwayBillNumber
    OriginAndDestination
    TotalConsignmentSummary
    [Slant *LineChar];

MasterAirwayBillNumber = AirlinePrefix Hyphen AWBSerialNumber;
AirlinePrefix = 3Digit;
AWBSerialNumber = 8Digit;

OriginAndDestination = AirportCode AirportCode;
AirportCode = 3Upper;

TotalConsignmentSummary =
    Slant
    "T"
    TotalPieceCount
    WeightUnit
    TotalWeight
    [VolumeUnit VolumeAmount];

TotalPieceCount = 1*4Digit;
WeightUnit = "K" / "L";
TotalWeight = 1*10Digit ["." 1*3Digit];
VolumeUnit = "MC" / "CF" / 2Upper;
VolumeAmount = 1*10Digit ["." 1*3Digit];

# --- Flight bookings (FLT) ---
FlightBookingsLine =
    "FLT"
    Slant
    2Upper 1*4Digit [Upper] Slant 2Digit
    *(Slant 2Upper 1*4Digit [Upper] Slant 2Digit)
    EOL
    *ContinuationLine;

# --- Routing (RTG) ---
RoutingLine =
    "RTG"
    Slant
    AirportCode [2Upper]
    *(Slant AirportCode [2Upper])
    EOL;

# --- Shipper party block (SHP + NAM/ADR/LOC and continuations) ---
ShipperBlock = "SHP" [Slant *LineChar] EOL *ShipperSubLine;
ShipperSubLine = ShipperNameLine / ShipperAddressLine / ShipperLocationLine / ShipperContLine;
ShipperNameLine = "NAM" Slant *LineChar EOL;
ShipperAddressLine = "ADR" Slant *LineChar EOL;
ShipperLocationLine = "LOC" Slant *LineChar EOL;
ShipperContLine = Slant *LineChar EOL;

# --- Consignee party block (CNE + NAM/ADR/LOC and continuations) ---
ConsigneeBlock = "CNE" [Slant *LineChar] EOL *ConsigneeSubLine;
ConsigneeSubLine = ConsigneeNameLine / ConsigneeAddressLine / ConsigneeLocationLine / ConsigneeContLine;
ConsigneeNameLine = "NAM" Slant *LineChar EOL;
ConsigneeAddressLine = "ADR" Slant *LineChar EOL;
ConsigneeLocationLine = "LOC" Slant *LineChar EOL;
ConsigneeContLine = Slant *LineChar EOL;

# --- Agent (AGT) ---
AgentLine = AgentTagLine *AgentContLine;
AgentTagLine =
    "AGT"
    Slant
    *(%x20-2E / %x30-7E)
    Slant
    *(%x20-2E / %x30-7E)
    [Slant *(%x20-2E / %x30-7E)]
    [Slant *(%x20-2E / %x30-7E)]
    EOL;
AgentContLine = Slant *LineChar EOL;

# --- Accounting Information (ACC) ---
AccountingLine = AccountingTagLine *AccountingContLine;
AccountingTagLine = "ACC" Slant *LineChar EOL;
AccountingContLine = Slant *LineChar EOL;

# --- Charges Declaration (CVD) ---
CvdLine =
    "CVD"
    Slant
    3Upper
    Slant
    2Upper
    Slant
    2Upper
    Slant
    ("NVD" / 1*10Digit ["." 1*3Digit])
    Slant
    ("NCV" / "NVD" / 1*10Digit ["." 1*3Digit])
    Slant
    ("XXX" / 1*10Digit ["." 1*3Digit])
    EOL;

# --- Rate Description (RTD) ---
RatingLine = RatingTagLine *RatingContLine;
RatingTagLine = "RTD" Slant *LineChar EOL;
RatingContLine = Slant *LineChar EOL;

# --- Other Charges (OTH) ---
OtherChargesLine = OtherChargesTagLine *OtherChargesContLine;
OtherChargesTagLine = "OTH" Slant ("P" / "C") Slant *LineChar EOL;
OtherChargesContLine = Slant *LineChar EOL;

# --- Prepaid/Collect charges summary (PPD) ---
PrepaidLine = PrepaidTagLine *PrepaidContLine;
PrepaidTagLine =
    "PPD"
    Slant
    "WT"
    1*10Digit ["." 1*3Digit]
    Slant
    "VC"
    1*10Digit ["." 1*3Digit]
    Slant
    "TX"
    1*10Digit ["." 1*3Digit]
    *(Slant *LineChar)
    EOL;
PrepaidContLine = Slant *LineChar EOL;

# --- Certification and issuance ---
CertificationLine = "CER" Slant *LineChar EOL;
IssuanceLine =
    "ISU"
    Slant
    2Digit
    ("JAN" / "FEB" / "MAR" / "APR" / "MAY" / "JUN" /
     "JUL" / "AUG" / "SEP" / "OCT" / "NOV" / "DEC")
    2Digit
    Slant
    1*(%x20-2E / %x30-7E)
    Slant
    1*(%x20-2E / %x30-7E)
    *(Slant 1*(%x20-2E / %x30-7E))
    [EOL];

# --- Supplemental lines ---
SupplementalLine = OsiBlock / OciBlock / RefLine / SphLine / ArdLine / SriLine;

OsiBlock = OsiLine *ContinuationLine;
OsiLine = "OSI" Slant *LineChar EOL;

OciBlock = OciLine *ContinuationLine;
OciLine = "OCI" Slant *LineChar [EOL];

# FWB supplemental continuation lines may appear with 1 to 3 leading slashes.
ContinuationLine = Slant [Slant [Slant]] *LineChar [EOL];

RefLine = "REF" Slant *LineChar [EOL];

# COR appears in operational feeds as a SPH-family supplemental line.
SphLine = ("SPH" / "COR") Slant *LineChar [EOL];

# --- Special Service Request ---
SsrLine = SsrTagLine *SsrContLine;
SsrTagLine = "SSR" Slant *LineChar EOL;
SsrContLine = Slant *LineChar EOL;

# --- Notify party block ---
NotifyBlock = "NFY" [Slant *LineChar] EOL *NotifySubLine;
NotifySubLine = NotifyNameLine / NotifyAddressLine / NotifyLocationLine / NotifyContLine;
NotifyNameLine = "NAM" Slant *LineChar [EOL];
NotifyAddressLine = "ADR" Slant *LineChar [EOL];
NotifyLocationLine = "LOC" Slant *LineChar [EOL];
NotifyContLine = Slant *LineChar [EOL];

# --- Account and shipment reference identifiers ---
ArdLine = "ARD" Slant *LineChar [EOL];
SriLine = "SRI" Slant *LineChar [EOL];

# ------------------------ Character sets ------------------------

LineChar = %x20-7E;

EOL = [%x0D] %x0A;
Slant = "/";
Hyphen = "-";
Digit = %x30-39;
Upper = %x41-5A;
