# FFM/8 CIMP 34th edition grammar (structure-first with operational relaxations)

FFM8 =
	MessageHeader
	EOL
	FlightIdentificationLine
	EOL
	1*(ArrivalInformationLine EOL / UldSection)
	[TrailerLine [EOL]];

MessageHeader = "FFM/4" / "FFM/5" / "FFM/8";

# --- Flight identification ---
FlightIdentificationLine =
	MessagePageNumber
	Slant
	CarrierFlightNumber
	Slant
	ScheduledDepartureDateTime
	Slant
	DepartureAirportCode
	Slant
	AircraftRegistration;

# Arrival variants seen in operations include:
# - direct destination with scheduled arrival datetime: ORD//14APR1235
# - transit NIL with scheduled arrival and optional onward departure: ANC/NIL/14APR0200/14APR0330
# - bare destination (legacy FFM/4, FFM/5): ORD
# - bare NIL transit (legacy FFM/4, FFM/5): ANC/NIL
ArrivalInformationLine =
	DirectArrivalLine
	/ TransitNILArrivalLine
	/ TransitNILOnlyLine
	/ DestinationOnlyLine;

DirectArrivalLine = ArrivalAirportCode Slant Slant ScheduledArrivalDateTime;
TransitNILArrivalLine =
	ArrivalAirportCode
	Slant
	"NIL"
	Slant
	ScheduledArrivalDateTime
	[Slant ScheduledOnwardDepartureDateTime];
TransitNILOnlyLine = ArrivalAirportCode Slant "NIL";
DestinationOnlyLine = ArrivalAirportCode;

# Some traffic starts AWB blocks directly without an explicit ULD line.
UldSection =
	[ULDLine EOL]
	1*AwbBlock;

AwbBlock =
	AirWaybillLine
	EOL
	*SupplementLine;

SupplementLine =
	OsiLine EOL
	/ OciLine EOL
	/ SciLine EOL
	/ ContinuationLine EOL
	/ SlashQualifierLine EOL
	/ CorLine EOL;

# --- ULD and AWB lines ---
ULDLine = "ULD" Slant ULDIdentifier [Slant ULDDetailText];

AirWaybillLine =
	MasterAirwayBillNumber
	OriginAndDestination
	Slant
	ShipmentSummary
	[Slant FreeText];

# --- Supplement lines ---
OsiLine = "OSI" Slant *LineChar;
OciLine = "OCI" Slant *LineChar;
SciLine = "SCI" Slant *LineChar;
CorLine = "COR" Slant *LineChar;

SlashQualifierLine = Slant QualifierToken *(Slant QualifierToken);

# Explicit OCI-style continuation rows.
ContinuationLine = Slant Slant Slant *LineChar;

TrailerLine = "CONT" / "LAST";

# -------------------------- Elements --------------------------

MessagePageNumber = 1*2Digit;
CarrierFlightNumber = 2*8AlphaNum;
ScheduledDepartureDateTime = ScheduledDepartureDate [ScheduledDepartureTime];
ScheduledDepartureDate = 2Digit Month;
ScheduledDepartureTime = 4Digit;
ScheduledArrivalDateTime = ScheduledArrivalDate [ScheduledArrivalTime];
ScheduledArrivalDate = 2Digit Month;
ScheduledArrivalTime = 4Digit;
ScheduledOnwardDepartureDateTime = ScheduledOnwardDepartureDate [ScheduledOnwardDepartureTime];
ScheduledOnwardDepartureDate = 2Digit Month;
ScheduledOnwardDepartureTime = 4Digit;
DepartureAirportCode = 3Upper;
ArrivalAirportCode = 3Upper;
AircraftRegistration = 4*12AlphaNum;

MasterAirwayBillNumber = AirlinePrefix Hyphen AWBSerialNumber;
AirlinePrefix = 3Digit;
AWBSerialNumber = 8Digit;

OriginAndDestination = AirportCode AirportCode;
AirportCode = 3Upper;

ULDIdentifier = 5*20ULDChar;
ULDDetailText = 1*LineChar;

ShipmentSummary =
	SummaryType
	PieceCount
	WeightUnit
	WeightValue
	["M" VolumeUnit VolumeAmount]
	["T" TotalPieceCount];

SummaryType = "S" / "T" / "D" / "P";
PieceCount = 1*4Digit;
TotalPieceCount = 1*4Digit;
WeightUnit = "K" / "L";
WeightValue = 1*7Digit [Dot 1*3Digit];
VolumeUnit = 1*2Upper;
VolumeAmount = 1*6Digit [Dot 1*3Digit];

Month =
	"JAN" / "FEB" / "MAR" / "APR" / "MAY" / "JUN" /
	"JUL" / "AUG" / "SEP" / "OCT" / "NOV" / "DEC";
FreeText = 1*LineChar;

# ------------------------ Character sets ------------------------

ULDChar = AlphaNum / Hyphen;
SummaryChar = AlphaNum / Dot / Hyphen;
# Per CIMP 34 §8.8.1 OCI composition rules:
# - /CC//CRI/data form (empty information identifier) is valid
# - //DNR/data form is a CIMP-valid DNR overflow continuation
# QualifierToken allows empty (zero-or-more) so that embedded double-slashes
# are accepted.  ContinuationLine (///) must remain ordered before this rule.
QualifierToken = *NoSlashChar;
NoSlashChar = %x20-2E / %x30-7E;

LineChar = %x20-7E;

Slant = "/";
Hyphen = "-";
Dot = ".";

Digit = %x30-39;
Upper = %x41-5A;
AlphaNum = Upper / Digit;
EOL = [%x0D] %x0A;
