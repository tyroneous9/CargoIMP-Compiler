# FHL/4 CIMP grammar - full message parse
# CIMP 34th edition - all FHL segment types

FHL4 =
    MessageHeader EOL
    MasterBillLine EOL
    HouseBillLine EOL
    [DescriptionBlock]
    [ShipperBlock]
    [ConsigneeBlock]
    [CvdLine];

MessageHeader = "FHL/4";

# --- Master Bill Information line ---
# e.g. MBI/933-34507281HKGORD/T94K1045
MasterBillLine = "MBI" Slant MasterAirwayBillNumber MasterOriginAndDestination MasterBillSummary *LineChar;

MasterAirwayBillNumber = AirlinePrefix Hyphen AWBSerialNumber;
AirlinePrefix = 3Digit;
AWBSerialNumber = 8Digit;

# Origin-destination in the MBI line
MasterOriginAndDestination = AirportCode AirportCode;
AirportCode = 3Upper;

# e.g. /T94K1045
MasterBillSummary = Slant "T" MasterPieceCount MasterWeightUnit MasterWeight;
MasterPieceCount = 1*4Digit;
MasterWeightUnit = Upper;
MasterWeight = 1*7Digit ["." 1*6Digit];

# --- House Bill Summary line ---
# e.g. HBS/ORD20260411/HKGORD/94/K1045/94/ELECTRONIC SCAL
HouseBillLine = "HBS" Slant HouseWaybillNumber Slant HouseOriginAndDestination Slant HousePieceCount Slant HouseWeightUnit HouseWeight *LineChar;

# Origin-destination in the HBS line (separate rule to distinguish from the master bill)
HouseOriginAndDestination = AirportCode AirportCode;

HouseWaybillNumber = 1*20AlphaNum;
HousePieceCount = 1*4Digit;
HouseWeightUnit = Upper;
HouseWeight = 1*7Digit ["." 1*6Digit];

# --- Description text block ---
# e.g. TXT/ELECTRONIC SCALE ESSENTIAL OIL...
DescriptionBlock = DescriptionTagLine *DescriptionContLine;
DescriptionTagLine = "TXT" Slant *LineChar EOL;
DescriptionContLine = Slant *LineChar EOL;

# --- Shipper party block ---
# e.g. SHP/ASIAHUB INTL TRADING LTD
ShipperBlock = ShipperTagLine *ShipperContLine;
ShipperTagLine = "SHP" Slant *LineChar EOL;
ShipperContLine = Slant *LineChar EOL;

# --- Consignee party block ---
# e.g. CNE/ECOM EXP INC
ConsigneeBlock = ConsigneeTagLine *ConsigneeContLine;
ConsigneeTagLine = "CNE" Slant *LineChar EOL;
ConsigneeContLine = Slant *LineChar EOL;

# --- Charges Value Declaration ---
# e.g. CVD/HKD/PP/NVD/NCV/XXX
CvdLine = "CVD" Slant *LineChar [EOL];

LineChar = %x20-7E;
EOL = [%x0D] %x0A;
Slant = "/";
Hyphen = "-";
Digit = %x30-39;
Upper = %x41-5A;
AlphaNum = Upper / Digit;
